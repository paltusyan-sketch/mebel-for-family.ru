{
  "name": "mebel-tailwind",
  "version": "1.0.0",
  "dependencies": {
    "tailwindcss": "^3.4.4",
    "nodemon": "^3.1.0"
  },
  "scripts": {
    "build": "tailwindcss -i ./backend/app1/static/css/tailwind-input.css -o ./backend/app1/static/css/tailwind-all.css",
    "watch": "nodemon -L --watch backend/app1/templates --watch backend/app1/static/css/tailwind-input.css -e html,css --exec \"npm run build\""
  }
}
